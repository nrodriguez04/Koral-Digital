# Public, non-secret values for production builds. Next.js inlines NEXT_PUBLIC_*
# into the browser bundle at build time, and the Cloudflare Worker reads this
# file at runtime too, so these are set here rather than in the dashboard.
# Secrets (DATABASE_URL, APP_SECRET, DESCOPE_MANAGEMENT_KEY, ...) never go in
# this file: see DEPLOYMENT.md. A local .env.local overrides these.
NEXT_PUBLIC_SITE_URL=https://koraldigital.com
NEXT_PUBLIC_DESCOPE_PROJECT_ID=P3LswDLfBtw8cQSVI57K4vNmQlD9
NEXT_PUBLIC_DESCOPE_SIGN_IN_FLOW_ID=koral-digital-sign-in
