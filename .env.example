# ---------------------------------------------------------------------------
# Koral Digital — environment variables. Copy to .env.local for development.
# NEVER commit real values. In production set these in Vercel → Project →
# Settings → Environment Variables (Production scope unless noted).
# ---------------------------------------------------------------------------

# Public canonical URL (no trailing slash). Production: https://koraldigital.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL. Use the POOLED connection string for the app (Supabase "Transaction
# pooler" port 6543, or Neon "-pooler" host). Required for forms and portals.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/koral_dev
# Optional direct (non-pooled) URL used only by migrations.
DATABASE_URL_UNPOOLED=

# 32+ random characters. Generate: openssl rand -base64 48
APP_SECRET=

# --- Descope authentication -------------------------------------------------
# Project ID from https://app.descope.com/settings/project (required for sign-in)
NEXT_PUBLIC_DESCOPE_PROJECT_ID=
# Optional custom domain / base URL for Descope (leave empty for default)
NEXT_PUBLIC_DESCOPE_BASE_URL=
# Flow to render on /sign-in. Use a SIGN-IN-ONLY flow (no self sign-up) in production.
NEXT_PUBLIC_DESCOPE_SIGN_IN_FLOW_ID=sign-in
# Optional but recommended: management key (server-only). Enables Descope-sent
# invitation emails and verified-email lookup for invitation matching.
DESCOPE_MANAGEMENT_KEY=
# One-time bootstrap: the first signed-in user who enters this token at /setup
# becomes superadmin (only while no staff account exists). Remove after use.
SETUP_TOKEN=

# --- Email notifications (Resend) -------------------------------------------
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend, e.g. "Koral Digital <notifications@koraldigital.com>"
EMAIL_FROM=
# Comma-separated recipients for new-inquiry alerts (overrides admin setting)
LEAD_NOTIFICATION_EMAILS=

# --- Client document storage (S3-compatible: Supabase Storage, R2, AWS S3) ---
# s3 | local (development only) | none (uploads disabled)
STORAGE_DRIVER=none
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Path-style URLs (true for Supabase Storage and most S3-compatible providers)
S3_FORCE_PATH_STYLE=true

# --- Search & analytics -----------------------------------------------------
# Google Search Console "HTML tag" verification content value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Optional cookieless Plausible analytics domain (e.g. koraldigital.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# auto (index only on Vercel production) | on | off
SITE_INDEXING=auto

# --- Local development only -------------------------------------------------
# Enables /dev-login with synthetic accounts. IGNORED in production builds and on Vercel.
AUTH_DEV_MOCK=false
